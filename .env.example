# Database (app role — non-superuser, RLS enforced)
DATABASE_URL=postgresql://defterfab_app:app@localhost:5432/defterfab_dev
# Migration URL (superuser — for prisma migrate)
DATABASE_MIGRATION_URL=postgresql://defterfab:dev@localhost:5432/defterfab_dev
# Test database
DATABASE_TEST_URL=postgresql://defterfab_app:app@localhost:5433/defterfab_test
DATABASE_TEST_MIGRATION_URL=postgresql://defterfab:test@localhost:5433/defterfab_test

# Auth
AUTH_SECRET=generate-a-random-secret-here
AUTH_URL=http://localhost:3000

# Azure Blob Storage (Azurite local emulator)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;
AZURE_STORAGE_CONTAINER=documents

# Azure Document Intelligence (OCR)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Background jobs (pg-boss, in-process — runs on DATABASE_URL; see docs/async-jobs.md)
# JOBS_DISABLED=1      # skip the worker (builds, scripts)
# JOBS_POOL_MAX=2      # pg-boss's own connection pool

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=  # CI only — for source map uploads

# Logging
LOG_LEVEL=debug

# ECB API (no auth needed)
ECB_API_BASE_URL=https://data-api.ecb.europa.eu/service/data

# CI/CD (GitHub Actions - set as repository secrets when deploying)
# AZURE_CREDENTIALS={"clientId":"...","clientSecret":"...","subscriptionId":"...","tenantId":"..."}
# ACR_LOGIN_SERVER=defterfab.azurecr.io
# ACR_USERNAME=defterfab
# ACR_PASSWORD=<from Azure Portal>
# AZURE_RESOURCE_GROUP=defterfab-rg
# PRODUCTION_DATABASE_URL=postgresql://...
