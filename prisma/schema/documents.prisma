// Module documents
// Models follow the mandatory template (id, tenantId, createdAt, updatedAt, createdBy, source);
// enums are PostgreSQL-level; RLS uses current_setting('app.tenant_id')::uuid. See prisma/schema/README.md.

// DEPRECATED (4.4, D6): the configurable prefix engine is gone — keys are fixed functions in
// src/modules/numbering and counters live in number_series. Table kept until the drop migration is
// approved (constitution: ask before a migration that drops data). Nothing reads or writes it.
model DocumentTypePrefix {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(30) // "expense", "invoice", "contract"
  prefix       String   @db.VarChar(10) // "exp_", "inv_", "ctrt_"
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String   @map("created_by") @db.Uuid
  source       String   @default("web") @db.VarChar(20)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentType], map: "document_type_prefixes_tenant_document_type_unique")
  @@map("document_type_prefixes")
}

model Document {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  businessKey  String   @map("business_key") @db.VarChar(100)
  fileName     String   @map("file_name") @db.VarChar(255)
  blobUrl      String   @map("blob_url") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(50)
  fileSize     Int      @map("file_size")
  prefixType   String   @map("prefix_type") @db.VarChar(30)
  documentType String   @map("document_type") @db.VarChar(20)
  status       String   @default("uploaded") @map("status") @db.VarChar(20)
  ocrData      Json?    @map("ocr_data") @db.JsonB
  corrections  Json?    @map("corrections") @db.JsonB
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedBy   String?  @map("reviewed_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String   @map("created_by") @db.Uuid
  source       String   @default("web")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status], map: "idx_documents_tenant_status")
  @@index([tenantId, businessKey], map: "idx_documents_tenant_business_key")
  @@map("documents")
}

/// Per-tenant monthly counter behind business keys (raw SQL in business-key.ts). Replaced by number_series in v3 (D5/D6).
// DEPRECATED (4.4): superseded by number_series (`doc-yyyy-mm`), counters carried over by the
// add_number_series migration. Dropped together with DocumentTypePrefix.
model DocumentKeyCounter {
  tenantId  String @map("tenant_id") @db.Uuid
  yearMonth String @map("year_month") @db.Char(7)
  nextVal   Int    @default(1) @map("next_val")

  @@id([tenantId, yearMonth])
  @@map("document_key_counters")
}
