// ─────────────────────────────────────────────────────────────
// App domain models — all follow the mandatory template:
// id, tenantId, createdAt, updatedAt, createdBy, source
//
// Better Auth's organization.id maps to tenantId on every model.
// RLS policies use current_setting('app.tenant_id')::uuid.
// Enums are PostgreSQL-level (raw SQL in migrations), NOT Prisma-level.
// ─────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  orgNumber String?  @map("org_number")
  address   String?
  currency  String   @default("SEK")
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenantConfigs        TenantConfig[]
  basPreferences       TenantBasPreference[]
  vatRegistrations     VatRegistration[]
  bankAccounts         BankAccount[]
  documentTypePrefixes DocumentTypePrefix[]
  partners             Partner[]
  contracts            Contract[]
  documents            Document[]

  @@map("tenants")
}

/// Sample domain model to validate the mandatory template pattern with RLS.
/// This minimal model proves the RLS + tenant-client pipeline end-to-end.
/// Will be extended or replaced by real domain models in later stories.
model TenantConfig {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String   @map("created_by") @db.Uuid
  source    String   @default("system")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_configs")
}

// ECB exchange rate cache — global (no tenantId), immutable (no updatedAt).
// Not following mandatory template: this is a cache of external public data.
model EcbRate {
  date         DateTime @db.Date
  currencyPair String   @map("currency_pair")
  rate         Decimal  @db.Decimal(18, 6)
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  @@id([date, currencyPair])
  @@map("ecb_rates")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String   // 'create' | 'update' | 'delete'
  entityType String   @map("entity_type") // e.g., 'tenant_config', 'tenant'
  entityId   String   @map("entity_id") // Plain String, not @db.Uuid — future entities may have non-UUID IDs
  oldData    Json?    @map("old_data") @db.JsonB
  newData    Json?    @map("new_data") @db.JsonB
  source     String   // 'web' | 'mcp' | 'cli' | 'system'
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // NO updatedAt — audit logs are immutable
  // NO tenant relation — audit_logs should not cascade-delete with tenant

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId])
  @@map("audit_logs")
}

// BAS reference table — NO RLS, read-only, natural key
// Not following mandatory template: this is app-level reference data, not tenant-scoped
model BasCategory {
  code           String   @id // "501" — 3-digit BAS group code (natural key, not UUID)
  name           String // "Lokalkostnader" — Swedish canonical
  nameEn         String?  @map("name_en") // "Premises costs" — from English 2025 file
  nameFr         String?  @map("name_fr") // "Frais de locaux" — AI-generated, Plan Comptable/IFRS
  className      String   @map("class_name") // "LOKALKOSTNADER" — stored uppercase per BAS standard
  classNum       Int      @map("class_num") // 5 — first digit of code
  isCommon       Boolean  @default(false) @map("is_common")
  suggestedAlias String?  @map("suggested_alias") // "Lokal" — curated short label
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  preferences TenantBasPreference[]
  partners    Partner[]

  @@map("bas_categories")
}

// Tenant BAS preferences — full RLS, follows mandatory template
model TenantBasPreference {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  basCode      String   @map("bas_code") // FK to BasCategory.code
  isFavorite   Boolean  @default(false) @map("is_favorite")
  shortCode    String?  @map("short_code") // User-defined alias
  translations Json?    @db.JsonB // { en?: string, sv?: string, fr?: string }
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String   @map("created_by") @db.Uuid
  source       String   @default("web")

  basCategory BasCategory @relation(fields: [basCode], references: [code])
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, basCode])
  @@index([tenantId, isFavorite])
  @@map("tenant_bas_preferences")
}

// VAT registrations — per-tenant multi-country VAT management, full RLS
// Follows mandatory template (id, tenantId, createdAt, updatedAt, createdBy, source)
// rate_schedule: JSONB array of applicable VAT rates, e.g., { rates: [25, 12, 6] }
// Downstream consumers: Epic 4 (contracts), Epic 10 (invoicing), declaration exports
model VatRegistration {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  country      String   @db.VarChar(2) // ISO 3166-1 alpha-2: "SE", "CH", "DE"
  vatNumber    String   @map("vat_number") @db.VarChar(50) // "SE556677889001", "CHE-123.456.789 MWST"
  rateSchedule Json?    @map("rate_schedule") @db.JsonB // { rates: [25, 12, 6] }
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String   @map("created_by") @db.Uuid
  source       String   @default("web")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts Contract[]

  @@unique([tenantId, country, vatNumber])
  @@index([tenantId])
  @@map("vat_registrations")
}

// Bank CSV format library — app-level reference data (NO RLS, no tenantId)
// Not following mandatory template: this is app-level reference data, not tenant-scoped
// Immutable via PostgreSQL RULEs (no UPDATE, no DELETE, no INSERT after seed)
// Downstream: Epic 6 CSV import, Epic 9 format admin
model BankFormat {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @unique @db.VarChar(100) // "Nordea CSV (Sweden)"
  bankName         String   @map("bank_name") @db.VarChar(100) // "Nordea"
  delimiter        String   @db.VarChar(10) // ";"
  decimalSeparator String   @map("decimal_separator") @db.VarChar(5) // ","
  dateFormat       String   @map("date_format") @db.VarChar(30) // "YYYY/MM/DD"
  encoding         String   @db.VarChar(30) // "ISO-8859-1"
  columnMapping    Json     @map("column_mapping") @db.JsonB // field-to-column map
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  bankAccounts BankAccount[]

  @@map("bank_formats")
}

// Bank accounts — per-tenant, full RLS, follows mandatory template
// Each record = one bank account + currency combination
// No bankName column — derived from format relation (bankFormat.bankName)
// Downstream: Epic 6 CSV import, Epic 6 banking view
model BankAccount {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  accountAlias  String?  @map("account_alias") @db.VarChar(100) // Optional friendly name
  accountNumber String   @map("account_number") @db.VarChar(50) // "211 53 13-5"
  currency      String   @db.VarChar(3) // "SEK", "CHF", etc.
  bankFormatId  String   @map("bank_format_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy     String   @map("created_by") @db.Uuid
  source        String   @default("web")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankFormat BankFormat @relation(fields: [bankFormatId], references: [id])

  @@unique([tenantId, accountNumber, currency])
  @@index([tenantId])
  @@index([bankFormatId])
  @@map("bank_accounts")
}

// Document-type prefixes — per-tenant, full RLS, follows mandatory template
// Configurable prefixes for business key generation (e.g., "exp_", "inv_")
// Document types are free-form strings — this table IS the configurable type registry
// Downstream: Epic 5 (document upload uses prefixes for business keys)
model DocumentTypePrefix {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(30) // "expense", "invoice", "contract"
  prefix       String   @db.VarChar(10) // "exp_", "inv_", "ctrt_"
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String   @map("created_by") @db.Uuid
  source       String   @default("web")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentType])
  @@map("document_type_prefixes")
}

/// User-scoped (not tenant-scoped). Access controlled by userId from auth context, not RLS.
model UserPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid // NO Prisma @relation — cross-schema FK, application-level enforcement
  locale    String?  // BCP 47 tag (e.g., "sv-SE", "en-US"), null = use browser locale
  source    String   @default("manual") // Always "manual" for user preferences — mandatory template compliance
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("user_preferences")
}

/// User-scoped table preferences (not tenant-scoped). Access controlled by userId from auth context, not RLS.
/// Stores per-user per-table filter/sort/pagination preferences for cross-session persistence.
model TablePreference {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tableKey    String   @map("table_key") @db.VarChar(50)
  preferences Json     @map("preferences") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, tableKey])
  @@map("table_preferences")
}

// Partners — per-tenant domain entity, full RLS, follows mandatory template
// First domain entity CRUD (pattern-setter for Story 4.2+)
// Soft-delete via is_active boolean (not deleted_at)
// types: text[] validated by Zod (not PG enum — see Dev Notes)
model Partner {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  name                 String
  orgNumber            String?  @map("org_number")
  vatNumber            String?  @map("vat_number")
  types                String[] @default([])
  defaultCurrency      String?  @map("default_currency")
  defaultLanguage      String?  @map("default_language")
  defaultBasCategoryCode String?  @map("default_bas_category_code")
  externalIdentifiers    Json     @default("[]") @map("external_identifiers")
  email                String?
  phone                String?
  address              Json?
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy            String   @map("created_by") @db.Uuid
  source               String   @default("web")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  basCategory BasCategory? @relation(fields: [defaultBasCategoryCode], references: [code])

  contracts         Contract[] @relation("PartnerContracts")
  employeeContracts Contract[] @relation("EmployeeContracts")

  @@map("partners")
}

// Contracts — child entity of Partner (client), full RLS, follows mandatory template
// Belongs to a client-type partner, optional employee assignment
// Soft-delete via is_active boolean
// billingRate: Decimal(15,2) — first money field in codebase
model Contract {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  name                String
  partnerId           String    @map("partner_id") @db.Uuid
  startDate           DateTime  @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  assignedEmployeeId  String?   @map("assigned_employee_id") @db.Uuid
  billingRate         Decimal?  @map("billing_rate") @db.Decimal(15, 2)
  currency            String?
  paymentTerms        String?   @map("payment_terms")
  vatRegistrationId   String?   @map("vat_registration_id") @db.Uuid
  externalReferences  Json      @default("[]") @map("external_references")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy           String    @map("created_by") @db.Uuid
  source              String    @default("web")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner          Partner          @relation("PartnerContracts", fields: [partnerId], references: [id])
  assignedEmployee Partner?         @relation("EmployeeContracts", fields: [assignedEmployeeId], references: [id])
  vatRegistration  VatRegistration? @relation(fields: [vatRegistrationId], references: [id], onDelete: SetNull)

  @@index([tenantId, partnerId])
  @@map("contracts")
}

// Documents — per-tenant, full RLS, follows mandatory template
// Stores uploaded business documents with automatic business key assignment
// Status and documentType are VARCHAR with Zod validation (not PG enums)
// ocrData: JSONB for raw Azure Document Intelligence response (Story 5.2)
model Document {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  businessKey  String   @map("business_key") @db.VarChar(100)
  fileName     String   @map("file_name") @db.VarChar(255)
  blobUrl      String   @map("blob_url") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(50)
  fileSize     Int      @map("file_size")
  prefixType   String   @map("prefix_type") @db.VarChar(30)
  documentType String   @map("document_type") @db.VarChar(20)
  status       String   @default("uploaded") @map("status") @db.VarChar(20)
  ocrData      Json?    @map("ocr_data") @db.JsonB
  corrections  Json?    @map("corrections") @db.JsonB
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedBy   String?  @map("reviewed_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String   @map("created_by") @db.Uuid
  source       String   @default("web")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status], map: "idx_documents_tenant_status")
  @@index([tenantId, businessKey], map: "idx_documents_tenant_business_key")
  @@map("documents")
}
