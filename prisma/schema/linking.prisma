// Module linking — the single link table (constitution §2, D18).
// Only src/modules/linking writes rows here. Endpoints are polymorphic (type + id) — no cross-table FKs
// (RLS blocks them); existence is validated through each module's registered `linkable`.
// `kind` is constrained by a CHECK in the migration: justifies | transfer | settles | belongs_to | created_from
// (created_from is exclusive on both ends — partial unique indexes, 20261020190000).
// Links are immutable (no updated_at): an allocation change is remove + create, both audited.
// F114 (D60): a `justifies` / `settles` link IS the payment record — `allocated_amount` in the target entity's
// currency (what part of it this row pays), `allocated_base` what the bank row gave for it in the tenant's base;
// the two are null together (CHECK). Σ amount onto an entity ≤ its amount and Σ base from a bank row ≤ |its base|
// are checked by the trigger `links_check_allocation` (migration 20261027200100) as well as by the service.

model Link {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  fromType        String   @map("from_type") @db.VarChar(40)
  fromId          String   @map("from_id") @db.Uuid
  toType          String   @map("to_type") @db.VarChar(40)
  toId            String   @map("to_id") @db.Uuid
  kind            String   @db.VarChar(20)
  allocatedAmount Decimal? @map("allocated_amount") @db.Decimal(15, 2)
  currency        String?  @db.VarChar(3)
  allocatedBase   Decimal? @map("allocated_base") @db.Decimal(15, 2)
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String   @map("created_by") @db.Uuid
  source          String   @default("web") @db.VarChar(20)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromType, fromId, toType, toId, kind], map: "links_tenant_endpoints_kind_key")
  // The two below are PARTIAL unique indexes (WHERE kind = 'created_from', migration 20261020190000):
  // one origin per document, one document per entity (D27). Declared so the drift check knows them;
  // Prisma cannot express the predicate, so never use them as findUnique keys — they are not unique in general.
  @@unique([tenantId, toType, toId], map: "links_created_from_origin_key")
  @@unique([tenantId, fromType, fromId], map: "links_created_from_entity_key")
  @@index([tenantId, fromType, fromId], map: "idx_links_from")
  @@index([tenantId, toType, toId], map: "idx_links_to")
  @@map("links")
}

// F98 (specs/ai): proposals — what the rules, the history and (PR 2) the local model propose for a bank row's
// category or partner. The ONLY table the AI side writes: no fact, no link, no status is written by a proposal —
// accepting one goes through banking's `categorise` (the owner's key). *Current* (the newest run per target and
// kind), *superseded* and *open* are derived on read. Owned by modules/linking.

/// what a proposal is about — a bank row, or a document before it becomes an expense / a supplier invoice (F126)
enum ProposalTarget {
  bank_transaction
  document

  @@map("proposal_target")
}

/// the fact proposed
enum ProposalKind {
  bas
  partner

  @@map("proposal_kind")
}

/// where it came from — shown to the owner as a word (the owner, 2026-10-27)
enum ProposalSource {
  rule
  partner_default
  memory
  model

  @@map("proposal_source")
}

/// the owner's key — a fact with a time, never a status
enum ProposalDecision {
  accepted
  rejected

  @@map("proposal_decision")
}

model Proposal {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  /// the job run that made it — the newest run per (target, kind) is the current proposal
  runId         String            @map("run_id") @db.Uuid
  targetType    ProposalTarget    @map("target_type")
  targetId      String            @map("target_id") @db.Uuid
  kind          ProposalKind
  /// the proposal itself, typed per kind (`proposals/payload.ts` parses it on read)
  payload       Json              @db.JsonB
  source        ProposalSource
  confidence    Decimal           @db.Decimal(3, 2)
  reason        String?           @db.VarChar(200)
  model         String?           @db.VarChar(100)
  promptVersion String?           @map("prompt_version") @db.VarChar(20)
  /// sha256 of the row's facts when proposed — a rejected proposal is not made again while it is unchanged
  factsHash     String            @map("facts_hash") @db.VarChar(64)
  decision      ProposalDecision?
  decidedAt     DateTime?         @map("decided_at") @db.Timestamptz
  decidedBy     String?           @map("decided_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String            @map("created_by") @db.Uuid

  /// the target again, in the column of its type — so each has its composite FK (a CHECK keeps them = target_id)
  bankTransactionId String? @map("bank_transaction_id") @db.Uuid
  documentId        String? @map("document_id") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// D63: composite FKs — the row / the document of the same tenant, RESTRICT; banking's deleteImport and documents'
  /// delete drop the proposals first
  bankTransaction BankTransaction? @relation(fields: [tenantId, bankTransactionId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  document        Document?        @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, targetType, targetId, kind, runId], map: "proposals_target_kind_run_key")
  @@index([tenantId, targetId, kind, createdAt(sort: Desc)], map: "idx_proposals_target")
  @@map("proposals")
}
