// Module linking — the single link table (constitution §2, D18).
// Only src/modules/linking writes rows here. Endpoints are polymorphic (type + id) — no cross-table FKs
// (RLS blocks them); existence is validated through each module's registered `linkable`.
// `kind` is constrained by a CHECK in the migration: justifies | transfer | settles | belongs_to | created_from
// (created_from is exclusive on both ends — partial unique indexes, 20261020190000).
// Links are immutable (no updated_at): an allocation change is remove + create, both audited.
// F114 (D60): a `justifies` / `settles` link IS the payment record — `allocated_amount` in the target entity's
// currency (what part of it this row pays), `allocated_base` what the bank row gave for it in the tenant's base;
// the two are null together (CHECK). Σ amount onto an entity ≤ its amount and Σ base from a bank row ≤ |its base|
// are checked by the trigger `links_check_allocation` (migration 20261027200100) as well as by the service.

model Link {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  fromType        String   @map("from_type") @db.VarChar(40)
  fromId          String   @map("from_id") @db.Uuid
  toType          String   @map("to_type") @db.VarChar(40)
  toId            String   @map("to_id") @db.Uuid
  kind            String   @db.VarChar(20)
  allocatedAmount Decimal? @map("allocated_amount") @db.Decimal(15, 2)
  currency        String?  @db.VarChar(3)
  allocatedBase   Decimal? @map("allocated_base") @db.Decimal(15, 2)
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String   @map("created_by") @db.Uuid
  source          String   @default("web") @db.VarChar(20)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromType, fromId, toType, toId, kind], map: "links_tenant_endpoints_kind_key")
  // The two below are PARTIAL unique indexes (WHERE kind = 'created_from', migration 20261020190000):
  // one origin per document, one document per entity (D27). Declared so the drift check knows them;
  // Prisma cannot express the predicate, so never use them as findUnique keys — they are not unique in general.
  @@unique([tenantId, toType, toId], map: "links_created_from_origin_key")
  @@unique([tenantId, fromType, fromId], map: "links_created_from_entity_key")
  @@index([tenantId, fromType, fromId], map: "idx_links_from")
  @@index([tenantId, toType, toId], map: "idx_links_to")
  @@map("links")
}
