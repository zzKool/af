// Module supplier-invoices — payables (D8, D28, D-g; specs/supplier-invoices/spec.md)
// Models follow the mandatory template (id, tenantId, createdAt, updatedAt, createdBy, source);
// RLS uses current_setting('app.tenant_id')::uuid. See prisma/schema/README.md.
//
// A supplier invoice is a document reviewed by OCR, a partner (vendor), the supplier's number, the dates and a due
// date, an amount with VAT in CHF / EUR / SEK, and the bank rows that paid it (`justifies` links). It keys like an
// expense in the same group (`SI213-Acc-01`, the per-group × alias counter is shared). Unpaid / partially paid /
// paid / overdue are DERIVED from the links and the due date; `cancelled` is the only typed state (a reason, never
// a delete once a document or a link exists). `partner_id` and `vat_registration_id` are validated UUIDs; the group
// is an intra-module FK on purpose — the key carries the group number.

model SupplierInvoice {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  groupId           String   @map("group_id") @db.Uuid
  /// `SI213-Acc-01` — group number, BAS alias snapshot, sequence per (group, alias) shared with expenses
  key               String   @db.VarChar(30)
  seq               Int
  alias             String   @db.VarChar(6)
  /// the supplier (partners module, type vendor) — validated UUID
  partnerId         String   @map("partner_id") @db.Uuid
  /// the supplier's own number (`9160`), unique per supplier
  invoiceNumber     String   @map("invoice_number") @db.VarChar(100)
  invoiceDate       DateTime @map("invoice_date") @db.Date
  dueDate           DateTime @map("due_date") @db.Date
  /// the due date came from the partner's terms, not the invoice — review it
  dueDateDefaulted  Boolean  @default(false) @map("due_date_defaulted")
  currency          String   @db.Char(3)
  amountNet         Decimal  @map("amount_net") @db.Decimal(15, 2)
  vatAmount         Decimal  @map("vat_amount") @db.Decimal(15, 2)
  amountTotal       Decimal  @map("amount_total") @db.Decimal(15, 2)
  /// SEK base of the total: ECB of the invoice date; the bank row's base once a cross-currency payment is attached
  amountBase        Decimal  @map("amount_base") @db.Decimal(15, 2)
  rate              Decimal  @db.Decimal(18, 6)
  /// same_currency | ecb_daily | ecb_nearest | bank | manual
  rateSource        String   @map("rate_source") @db.VarChar(20)
  rateDate          DateTime? @map("rate_date") @db.Date
  /// what the bank row paid when the payment is in another currency (D-g = D26), once attached
  paidAmount        Decimal? @map("paid_amount") @db.Decimal(15, 2)
  paidCurrency      String?  @map("paid_currency") @db.Char(3)
  /// 3-digit BAS group, validated at write
  basCode           String   @map("bas_code") @db.VarChar(4)
  /// the SE or CH registration this VAT is deductible under (validated UUID)
  vatRegistrationId String?  @map("vat_registration_id") @db.Uuid
  documentMissing   Boolean  @default(false) @map("document_missing")
  note              String?
  cancelled         Boolean  @default(false)
  cancelledReason   String?  @map("cancelled_reason")
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy         String   @map("created_by") @db.Uuid
  source            String   @default("web") @db.VarChar(20)

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  ExpenseGroup          @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines  SupplierInvoiceLine[]

  @@unique([tenantId, key], map: "supplier_invoices_tenant_key_key")
  @@unique([groupId, alias, seq], map: "supplier_invoices_group_alias_seq_key")
  /// exact duplicates; the case- and space-insensitive rule is the service's (no expression index: the drift check)
  @@unique([tenantId, partnerId, invoiceNumber], map: "supplier_invoices_tenant_partner_number_key")
  @@index([tenantId, dueDate])
  @@index([tenantId, invoiceDate(sort: Desc)])
  @@index([tenantId, partnerId])
  @@index([tenantId, groupId])
  @@map("supplier_invoices")
}

/// A VAT / category split — only when one invoice carries two rates or two categories; Σ net and Σ VAT equal the invoice's.
model SupplierInvoiceLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  lineNo      Int     @map("line_no")
  description String  @db.VarChar(200)
  amountNet   Decimal @map("amount_net") @db.Decimal(15, 2)
  /// percent, e.g. 8.10
  vatRate     Decimal @map("vat_rate") @db.Decimal(5, 2)
  vatAmount   Decimal @map("vat_amount") @db.Decimal(15, 2)
  basCode     String  @map("bas_code") @db.VarChar(4)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String   @map("created_by") @db.Uuid
  source      String   @default("web") @db.VarChar(20)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([invoiceId, lineNo], map: "supplier_invoice_lines_invoice_line_key")
  @@index([tenantId, invoiceId])
  @@map("supplier_invoice_lines")
}
