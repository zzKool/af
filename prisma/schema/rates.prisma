// Module rates — ECB reference rates
// Models follow the mandatory template (id, tenantId, createdAt, updatedAt, createdBy, source);
// enums are PostgreSQL-level; RLS uses current_setting('app.tenant_id')::uuid. See prisma/schema/README.md.

model EcbRate {
  date         DateTime @db.Date
  currencyPair String   @map("currency_pair")
  rate         Decimal  @db.Decimal(18, 6)
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  @@id([date, currencyPair])
  @@map("ecb_rates")
}
