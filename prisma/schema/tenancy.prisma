// Kernel — tenancy (Tenant, TenantConfig)
// Models follow the mandatory template (id, tenantId, createdAt, updatedAt, createdBy, source);
// enums are PostgreSQL-level; RLS uses current_setting('app.tenant_id')::uuid. See prisma/schema/README.md.

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  orgNumber String?  @map("org_number")
  address   String?
  /// printed on invoices (D7): contact line and footer
  email     String?  @db.VarChar(254)
  website   String?  @db.VarChar(200)
  phone     String?  @db.VarChar(30)
  currency  String   @default("SEK")
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenantConfigs        TenantConfig[]
  basPreferences       TenantBasPreference[]
  vatRegistrations     VatRegistration[]
  bankAccounts         BankAccount[]
  bankImports          BankImport[]
  bankTransactions     BankTransaction[]
  categorisationRules  CategorisationRule[]
  journalEntries       JournalEntry[]
  partners             Partner[]
  partnerContacts      PartnerContact[]
  contracts            Contract[]
  contractRates        ContractRate[]
  invoices             Invoice[]
  invoiceLines         InvoiceLine[]
  expenseGroups        ExpenseGroup[]
  expenses             Expense[]
  settlements          Settlement[]
  normalbelopp         Normalbelopp[]
  trips                Trip[]
  supplierInvoices     SupplierInvoice[]
  supplierInvoiceLines SupplierInvoiceLine[]
  subscriptions        Subscription[]
  subscriptionPrices   SubscriptionPrice[]
  subscriptionPauses   SubscriptionPause[]
  documents            Document[]
  links                Link[]
  packageBuilds        PackageBuild[]
  swissVatDeclarations SwissVatDeclaration[]
  numberSeries         NumberSeries[]

  @@map("tenants")
}

/// Sample domain model to validate the mandatory template pattern with RLS.
/// This minimal model proves the RLS + tenant-client pipeline end-to-end.
/// Will be extended or replaced by real domain models in later stories.
model TenantConfig {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String   @map("created_by") @db.Uuid
  source    String   @default("system")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_configs")
}
