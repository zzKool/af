// Module partners
// Models follow the mandatory template (id, tenantId, createdAt, updatedAt, createdBy, source);
// enums are PostgreSQL-level; RLS uses current_setting('app.tenant_id')::uuid. See prisma/schema/README.md.

model Partner {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  name                 String
  /// 2–6 upper-case letters/digits; the invoice series key `{short_code}{yy}` (D5). Unique per tenant.
  shortCode            String?  @map("short_code") @db.VarChar(6)
  orgNumber            String?  @map("org_number")
  vatNumber            String?  @map("vat_number")
  types                String[] @default([])
  defaultCurrency      String?  @map("default_currency")
  defaultLanguage      String?  @map("default_language")
  defaultBasCategoryCode String?  @map("default_bas_category_code")
  /// a supplier's payment terms, the due-date default of its invoices (null = 30 days)
  paymentTermsDays     Int?     @map("payment_terms_days")
  externalIdentifiers    Json     @default("[]") @map("external_identifiers")
  email                String?
  phone                String?
  address              Json?
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy            String   @map("created_by") @db.Uuid
  source               String   @default("web")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  basCategory BasCategory? @relation(fields: [defaultBasCategoryCode], references: [code])

  contracts         Contract[] @relation("PartnerContracts")
  employeeContracts Contract[] @relation("EmployeeContracts")
  contacts          PartnerContact[]
  bankTransactions  BankTransaction[]

  /// D63: the target of composite (tenant_id, id) foreign keys from other modules (F113 first)
  @@unique([tenantId, id], map: "partners_tenant_id_id_key")
  @@unique([tenantId, orgNumber], map: "idx_partners_tenant_org") // created as a partial index (WHERE org_number IS NOT NULL) in the migration
  @@unique([tenantId, shortCode], map: "idx_partners_tenant_short_code") // partial index (WHERE short_code IS NOT NULL)
  @@map("partners")
}

/// A contact person of a partner (F08, specs/partners/spec.md): name, role, e-mail, phone. Not linkable;
/// deleted with its partner (intra-module FK, same tenant).
model PartnerContact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  name      String   @db.VarChar(200)
  role      String?  @db.VarChar(100)
  email     String?  @db.VarChar(254)
  phone     String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String   @map("created_by") @db.Uuid
  source    String   @default("web") @db.VarChar(20)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId, partnerId], map: "idx_partner_contacts_tenant_partner")
  @@map("partner_contacts")
}
