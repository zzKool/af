# The production stack's secrets — copy to .env.prod (gitignored). Same variable names as on Azure; only values differ.
# AF_IMAGE, AF_TAG and AF_PORT do NOT go here: compose reads them from a file named `.env` next to the compose
# file (interpolation), while this file only reaches the containers. See docs/deployment.md *The homelab*.
POSTGRES_DB=af
POSTGRES_USER=af
POSTGRES_PASSWORD=change-me
# the app connects as the RLS-enforced role created by the migrations; migrations run as the superuser.
# AF_APP_PASSWORD is set on the role by the migrate container after every deploy — keep DATABASE_URL in step with it.
AF_APP_PASSWORD=change-me-too
DATABASE_URL=postgresql://af_app:change-me-too@db:5432/af
DATABASE_MIGRATION_URL=postgresql://af:change-me@db:5432/af
AUTH_SECRET=generate-a-random-32-byte-secret
AUTH_URL=https://af.example.com
# once the owner has registered: closed = no /register, no sign-up, no new tenant (D61). Leave unset for the first run.
AUTH_SIGNUP=closed
# Documents (F107, D61): the compose sets STORAGE_DRIVER=fs and STORAGE_DIR=/data/documents (the `documents` volume).
# Azure Blob instead: STORAGE_DRIVER=blob here plus the real connection string; Azurite is never part of production.
# STORAGE_DRIVER=blob
# AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents
# OCR: azure (the default) — both keys required; a missing key fails every document's OCR with the reason, never a mock (F108)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
LOG_LEVEL=info
ECB_API_BASE_URL=https://data-api.ecb.europa.eu/service/data
# Chromium is in the image (CHROMIUM_PATH set by the Dockerfile); the PDF renderer reaches the app on localhost.
# INTERNAL_BASE_URL=http://127.0.0.1:3000
# Background jobs run in the same container (pg-boss on DATABASE_URL). JOBS_DISABLED=1 to turn the worker off.
# Errors: one JSON log line per unexpected error with a reference the user can quote (`docker compose logs app | grep <reference>`); nothing leaves the box (D51, F111).
