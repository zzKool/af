{
  "_about": "v1 advanced-table filter model as data: value shapes, filter-function semantics, chrome strings, density, formats. From components/advanced-table/{types,DataTable,checkbox-filter,number-range-filter,date-hierarchy-filter,utils}.ts(x) and lib/utils/date.ts.",
  "filterTypes": {
    "text": {
      "value": "string",
      "clearWhen": "'' or undefined",
      "filterFn": "TanStack includesString (case-insensitive contains)",
      "placeholder": "Search..."
