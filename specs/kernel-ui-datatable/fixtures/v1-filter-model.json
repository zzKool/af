    "select": {
      "value": "string[]",
      "clearWhen": "[]",
      "filterFn": "arrIncludesSome",
      "nullMarker": "__NULL__",
      "nullLabel": "Blank",
      "nullMatches": ["null", "undefined", "''"],
      "options": "string[] | {value,label}[] supplied by the page"
    },
    "number": {
      "value": "[min|null, max|null]",
      "clearWhen": "both null",
      "filterFn": "inNumberRange",
      "inclusive": true,
      "oneSided": true,
      "labels": { "min": "Min", "max": "Max" },
      "placeholder": "Enter value",
      "inputStep": "any"
    },
    "date": {
      "value": "{ years: Set<number>, months: Set<'YYYY-MM'>, days: Set<'YYYY-MM-DD'> }",
      "clearWhen": "all three empty",
      "filterFn": "dateInHierarchy",
